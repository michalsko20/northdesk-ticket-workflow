# Optional: docker compose up works without copying this file.
LLM_MODE=fake
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional Z.ai adapter: LLM_MODE=glm; credentials stay outside the repository.
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=
HELPDESK_FAILURE_RATE=0.2
# Direct/local execution defaults (Compose sets its own internal address/path):
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=northdesk-tickets
HELPDESK_DB_PATH=./helpdesk.db
# HTTP limits apply per API process; overload returns 503 + Retry-After.
HTTP_MAX_BODY_BYTES=262144
HTTP_MAX_INFLIGHT=32
HTTP_QUERY_CONCURRENCY=4
HTTP_QUERY_TIMEOUT_SECONDS=1
HTTP_BODY_TIMEOUT_SECONDS=10
# Workflow/query execution has a different budget from activities.
WORKER_ACTIVITY_CONCURRENCY=10
WORKER_WORKFLOW_CONCURRENCY=16
WORKER_MAX_CACHED_WORKFLOWS=512
# Local pytest only; the test image sets this automatically.
TEMPORAL_TEST_SERVER=.tools/temporal-test-server
# OpenTelemetry tracing (default: disabled for offline tests).
# Set OTEL_SDK_DISABLED=false to enable; spans go to OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
